# Copy this file to backend/.env and add an Anthropic API key before asking questions.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Local strict-evidence retrieval settings.
RERANKER_MODEL=BAAI/bge-reranker-base
RAG_CANDIDATE_LIMIT=24
RAG_MIN_RELEVANCE=0.50
RAG_MAX_EVIDENCE_PASSAGES=3
RAG_MAX_EVIDENCE_CHARS=1200

# Keep normal runtime fully local. Set to 1 only once on a new machine to
# download the embedding and reranking models into backend/rag_models.
ALLOW_MODEL_DOWNLOADS=0
